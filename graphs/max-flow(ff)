#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

// DFS
int dfs(int u, int t, vector<pair<int, int>>& e, vector<int>& cap, int n, vector<int>& vis, int flow) {
    if (u == t) return flow;

    vis[u] = 1;
    for (int i = 0; i < e.size(); i++) {
        int a = e[i].first, b = e[i].second;
        if (a == u && !vis[b] && cap[i] > 0) {
            int bot = dfs(b, t, e, cap, n, vis, min(flow, cap[i]));
            if (bot > 0) {
                cap[i] -= bot;
                cap[i ^ 1] += bot;
                return bot;
            }
        }
    }
    return 0;
}

// Ford-Fulkerson
int ff(int s, int t, vector<pair<int, int>>& e, vector<int>& cap, int n) {
    int max_f = 0;
    while (true) {
        vector<int> vis(n, 0);
        int bot = dfs(s, t, e, cap, n, vis, 1e9);
        if (bot == 0) break;
        max_f += bot;
    }
    return max_f;
}

int main() {
    // (0 -> 1 -> 3 i 0 -> 2 -> 3)
    vector<pair<int, int>> e1 = {
        {0,1}, {1,0},
        {0,2}, {2,0},
        {1,3}, {3,1},
        {2,3}, {3,2}
    };
    vector<int> c1 = {10,0, 5,0, 10,0, 10,0};
    cout << "Primer 1 (max flow): " << ff(0, 3, e1, c1, 4) << '\n'; // 15

    // (0 -> 1 -> 2 -> 3)
    vector<pair<int, int>> e2 = {
        {0,1}, {1,0},
        {1,2}, {2,1},
        {2,3}, {3,2}
    };
    vector<int> c2 = {20,0, 5,0, 15,0};
    cout << "Primer 2 (max flow): " << ff(0, 3, e2, c2, 4) << '\n'; //5

  
    vector<pair<int, int>> e3 = {
        {0,1}, {1,0},
        {0,2}, {2,0},
        {1,2}, {2,1},
        {1,3}, {3,1},
        {2,4}, {4,2},
