#include <iostream>
#include <cstdint>
using namespace std;

class SSOString {
    union {
        struct {
            uint8_t flag;
            char buf[15];
        };
        struct {
            char *arr;
            uint16_t sz;
            uint16_t cp;
        };
    };

    void copyFrom(const SSOString &other);
    bool isSSO() const;

public:
    SSOString();
    SSOString(const char *s);
    SSOString(const SSOString &other);
    ~SSOString();

    uint16_t size() const;
    uint16_t cap() const;
    SSOString &operator=(const SSOString &other);
    char& operator[](uint16_t idx);
    char operator[](uint16_t idx) const;
    char* data();
    const char* data() const;

    friend SSOString operator+(const SSOString &s1, const SSOString &s2);
    friend ostream &operator<<(ostream &os, const SSOString &str);
};

static uint16_t getLen(const char *s) {
    if (!s) return 0;
    uint16_t len = 0;
    while (s[len] != '\0') len++;
    return len;
}

static void str_copy(char *dst, const char *src) {
    uint16_t idx = 0;
    while (src[idx] != '\0') {
        dst[idx] = src[idx];
        idx++;
    }
    dst[idx] = '\0';
}

SSOString::SSOString() {
    this->flag = 1;
    this->buf[0] = '\0';
}

SSOString::~SSOString() {
    if (!this->isSSO()) delete[] this->arr;
}

SSOString::SSOString(const char *s) {
    uint16_t len = getLen(s);

    if (len <= 14) {
        this->flag = len * 2 + 1;
        if (s) str_copy(this->buf, s);
        else this->buf[0] = '\0';
    } else {
        this->arr = new char[len + 1];
        str_copy(this->arr, s);
        this->sz = len;
        this->cp = len;
    }
}

void SSOString::copyFrom(const SSOString &other) {
    if (other.isSSO()) {
        this->flag = other.flag;
        str_copy(this->buf, other.buf);
    } else {
        this->sz = other.sz;
        this->cp = other.cp;
        this->arr = new char[this->cp + 1];
        str_copy(this->arr, other.arr);
    }
}

SSOString::SSOString(const SSOString &other) {
    this->copyFrom(other);
}

SSOString& SSOString::operator=(const SSOString &other) {
    if (this != &other) {
        if (!this->isSSO()) delete[] this->arr;
        this->copyFrom(other);
    }
    return *this;
}

bool SSOString::isSSO() const {
    return this->flag % 2 == 1;
}

uint16_t SSOString::size() const {
    return this->isSSO() ? (this->flag / 2) : this->sz;
}

uint16_t SSOString::cap() const {
    return this->isSSO() ? 14 : this->cp;
}

const char* SSOString::data() const {
    return !this->isSSO() ? this->arr : this->buf;
}

char* SSOString::data() {
    return !this->isSSO() ? this->arr : this->buf;
}

char& SSOString::operator[](uint16_t idx) {
    return this->data()[idx];
}

char SSOString::operator[](uint16_t idx) const {
    return this->data()[idx];
}

ostream& operator<<(ostream &os, const SSOString &str) {
    os << str.data();
    return os;
}

SSOString operator+(const SSOString &s1, const SSOString &s2) {
    SSOString res;
    uint16_t len = s1.size() + s2.size();

    if (len <= 14) {
        res.flag = static_cast<uint8_t>((len << 1) | 1);
        str_copy(res.buf, s1.data());
        str_copy(res.buf + s1.size(), s2.data());
        return res;
    }
    res.arr = new char[len + 1];
    str_copy(res.arr, s1.data());
    str_copy(res.arr + s1.size(), s2.data());
    res.sz = len;
    res.cp = len;
    return res;
}

int main() {
    SSOString s1("Quick");
    SSOString s2(" test!");
    cout << "s1: " << s1.data() << " | " << s1.size() << " | " << s1.cap() << '\n'
         << "s2: " << s2 << " | " << s2.size() << " | " << s2.cap() << '\n';

    SSOString s3 = s1 + s2;
    cout << "s1+s2: " << s3 << " | " << s3.size() << " | " << s3.cap() << '\n';

    SSOString s4("Testing heap allocation when exceeding fourteen chars.");
    cout << "s4: " << s4 << " | " << s4.size() << " | " << s4.cap() << '\n';

    SSOString s5(s4);
    s5[0] = 'R';
    cout << "s5: " << s5 << '\n'
         << "s4 unchanged: " << s4 << '\n';

    SSOString s6;
    s6 = s3;
    cout << "s6: " << s6 << '\n';

    return 0;
}
